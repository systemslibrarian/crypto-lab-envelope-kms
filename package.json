{
  "name": "crypto-lab-envelope-kms",
  "private": true,
  "version": "0.1.0",
  "description": "Envelope encryption lab with KEK/DEK hierarchies and key rotation",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "gh workflow run pages.yml --repo systemslibrarian/crypto-lab-envelope-kms --ref main",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run && node --test tests/publish-request.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node --test tests/publish-request.test.mjs",
    "test:a11y": "playwright test",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemslibrarian/crypto-lab-envelope-kms.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/systemslibrarian/crypto-lab-envelope-kms/issues"
  },
  "homepage": "https://github.com/systemslibrarian/crypto-lab-envelope-kms#readme",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.10"
  }
}
